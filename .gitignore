# Local .terraform path
.terraform/

# `.tfstate` files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, etc. users should use the example files
*.tfvars
*.tfvars.json

# Ignore override files as they may contain local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include tfplan files to ignore them
*.tfplan
